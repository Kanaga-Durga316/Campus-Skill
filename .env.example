# ===== MongoDB =====
# Required: MongoDB connection string (Atlas or local)
# For MongoDB Atlas, use: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# ===== JWT =====
# Required in production: A strong, random secret string for signing JWT tokens
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ===== Server Port =====
# Optional: Defaults to 3001 if not set
PORT=3001

# ===== Frontend URL (for CORS) =====
# Required in production: The URL of your deployed frontend
# Example: https://campus-skill.vercel.app
FRONTEND_URL=

# ===== Node Environment =====
# Set to 'production' for deployment, 'development' for local
NODE_ENV=development

# ===== Vite (Frontend) =====
# Required in production: The URL of your deployed backend API
# Example: https://campus-skill.onrender.com
VITE_API_URL=

